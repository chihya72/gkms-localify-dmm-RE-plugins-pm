{
  "id": "pm.dlss5",
  "name": "DLSS 5 神经渲染（实验版）",
  "author": "pm",
  "repositoryUrl": "https://github.com/chihya72/gkms-localify-dmm-RE-plugins-pm/tree/main/gkms-dlss5",
  "version": "0.3.0-alpha.2",
  "description": "DX11 学马的实验性 NR。接入 OptiScaler/RenoDX 色彩管线，支持 25–200% 模型尺寸、四种缩小滤镜、同帧深度、冻结调参、并排／擦除对比和调试视图。实机效果仍需验证；尚未接入游戏实时曝光扫描与多点校准。",
  "punchline": "DX11 游戏接入，独立模型处理",
  "category": "画面与窗口",
  "tags": ["DLSS5", "Neural Rendering", "实验性"],
  "apiVersion": 2,
  "assembly": "Gkms.Dlss5.dll",
  "entryPoint": "Gkms.Dlss5.Plugin",
  "requiresRestart": true,
  "canReloadSettings": true,
  "settings": [
    { "key": "enableNeuralRendering", "label": "启用神经渲染（关闭时只诊断）", "type": "boolean", "default": false },
    { "key": "comparisonSplit", "label": "启用画面对比（原图／NR，黄色分界线）", "type": "boolean", "default": false },
    { "key": "runtimeDirectory", "label": "NR 运行库所在绝对目录", "type": "string", "default": "" },
    { "key": "modelScale", "label": "模型分辨率比例（1 原尺寸，1–2 超采样）", "type": "number", "default": 0.5, "min": 0.25, "max": 2 },
    { "key": "downFilter", "label": "超采样缩小：0区域平均 1双三次 2Lanczos2 3Lanczos3", "type": "integer", "default": 3, "min": 0, "max": 3 },
    { "key": "transferMode", "label": "低分辨率合成：0经典 1细节差异回传", "type": "integer", "default": 1, "min": 0, "max": 1 },
    { "key": "applyModel", "label": "显示模型增强结果（关闭显示原图，模型仍运行）", "type": "boolean", "default": true },
    { "key": "holdFrame", "label": "冻结输入画面调参（关闭恢复实时画面）", "type": "boolean", "default": false },
    { "key": "compareMode", "label": "对比方式：1完整画面并排 2分界擦除", "type": "integer", "default": 2, "min": 1, "max": 2 },
    { "key": "comparePosition", "label": "对比分界位置（擦除模式）", "type": "number", "default": 0.5, "min": 0, "max": 1 },
    { "key": "compareZoom", "label": "并排对比放大倍率", "type": "number", "default": 1, "min": 1, "max": 2 },
    { "key": "compareSwap", "label": "交换对比两侧", "type": "boolean", "default": false },
    { "key": "compareLabels", "label": "标注对比两侧（ORIG原图／NR增强）", "type": "boolean", "default": false },
    { "key": "debugView", "label": "查看：0合成画面 1模型输入 2模型原始输出 3放大差异", "type": "integer", "default": 0, "min": 0, "max": 3 },
    { "key": "debugGain", "label": "差异视图放大倍数", "type": "number", "default": 4, "min": 1, "max": 32 },
    { "key": "useDepth", "label": "使用同帧游戏深度（不可用时自动跳过）", "type": "boolean", "default": true },
    { "key": "depthInverted", "label": "反向深度（当前 DX11 游戏默认开启）", "type": "boolean", "default": true },
    { "key": "transferStrength", "label": "模型结果合成强度（0 原图，1 原模型，2 加强）", "type": "number", "default": 1, "min": 0, "max": 2 },
    { "key": "colorStrength", "label": "模型色彩混合（0保留游戏色相，1–4加强）", "type": "number", "default": 0.5, "min": 0, "max": 4 },
    { "key": "whitePoint", "label": "输入白点／曝光归一化", "type": "number", "default": 1, "min": 0.01, "max": 4096 },
    { "key": "exposureEV", "label": "模型输入曝光补偿 EV", "type": "number", "default": 0, "min": -4, "max": 4 },
    { "key": "autoExposure", "label": "估算自动白点（实验性，非游戏实时曝光）", "type": "boolean", "default": false },
    { "key": "codec", "label": "色彩桥接：0柔和高光 1Neutwo 2Neutwo直出 3混合曲线 4混合直出", "type": "integer", "default": 0, "min": 0, "max": 4 },
    { "key": "maxRatio", "label": "明暗变化保护倍率（合成模式）", "type": "number", "default": 2, "min": 1, "max": 8 },
    { "key": "inputEncoding", "label": "场景输入：0线性（默认） 1已编码sRGB", "type": "integer", "default": 0, "min": 0, "max": 1 },
    { "key": "flipY", "label": "修正模型画面上下方向（当前游戏开启）", "type": "boolean", "default": true },
    { "key": "style", "label": "NR 模型风格（0 默认，其他依运行库支持）", "type": "integer", "default": 0, "min": 0, "max": 3 },
    { "key": "capture", "label": "保存一次同帧对比图（原图／模型输入／输出／合成）", "type": "boolean", "default": false },
    { "key": "intensity", "label": "模型内部增强强度", "type": "number", "default": 1, "min": 0, "max": 2 },
    { "key": "toneStrength", "label": "光照与色调强度", "type": "number", "default": 0.25, "min": 0, "max": 2 },
    { "key": "structureStrength", "label": "材质细节强度", "type": "number", "default": 0.5, "min": 0, "max": 2 },
    { "key": "skinStrength", "label": "皮肤细节强度（-1 跟随材质细节）", "type": "number", "default": 0, "min": -1, "max": 2 },
    { "key": "autoMask", "label": "模型自动遮罩", "type": "boolean", "default": true },
    { "key": "preset", "label": "模型预设（0 为运行库默认）", "type": "integer", "default": 0, "min": 0, "max": 3 },
    { "key": "motionScaleX", "label": "运动矢量 X 倍率（乘画面宽度）", "type": "number", "default": -1, "min": -4, "max": 4 },
    { "key": "motionScaleY", "label": "运动矢量 Y 倍率（乘画面高度）", "type": "number", "default": -1, "min": -4, "max": 4 }
  ]
}
